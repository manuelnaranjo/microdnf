load("@bazel_lib//lib:transitions.bzl", "platform_transition_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary")
load("//bazel:gresource.bzl", "glib_compile_resources")

package(default_visibility = ["//visibility:public"])

SUPPORTED_PLATFORMS = [
    "linux_amd64",
    "linux_arm64",
    "osx_amd64",
    "osx_arm64",
]

PLUGINS = [
    "install",
    "reinstall",
    "remove",
    "upgrade",
    "swap",
    "distrosync",
    "repolist",
    "repoquery",
    "leaves",
    "clean",
    "download",
    "makecache",
    "module_enable",
    "module_disable",
    "module_reset",
    "rpm2archive",
    "lock",
    "mark",
]

[
    glib_compile_resources(
        name = "gresource_" + plugin,
        c_prefix = "dnf_command_" + plugin,
        out = "plugins/{}/dnf-command-{}.gresource.c".format(plugin, plugin),
        resources = ["plugins/{}/{}.plugin".format(plugin, plugin)],
        xml = "plugins/{}/dnf-command-{}.gresource.xml".format(plugin, plugin),
    )
    for plugin in PLUGINS
]

COMMON_COPTS = [
    "--std=gnu11",
    "-fstrict-aliasing",
    "-Wformat=2",
    "-Wunused",
    "-Wuninitialized",
    "-Wstrict-prototypes",
    "-Wmissing-prototypes",
    "-Werror=implicit",
    "-Werror=init-self",
    "-Werror=main",
]

cc_binary(
    name = "microdnf",
    srcs = [
        "dnf-command.c",
        "dnf-command.h",
        "dnf-main.c",
        "dnf-utils.c",
        "dnf-utils.h",
        "plugins/lock/lock.c",
        "plugins/lock/lock.h",
        "plugins/mark/mark.c",
        "plugins/mark/mark.h",
        "plugins/rpm2archive/rpm2archive.c",
        "plugins/rpm2archive/rpm2archive.h",
    ] + [
        "plugins/{}/dnf-command-{}.c".format(plugin, plugin)
        for plugin in PLUGINS
    ] + [
        "plugins/{}/dnf-command-{}.h".format(plugin, plugin)
        for plugin in PLUGINS
    ] + [
        ":gresource_" + plugin
        for plugin in PLUGINS
    ],
    copts = COMMON_COPTS,
    defines = [
        'PACKAGE_LIBDIR=\\"/usr/lib64/dnf\\"',
        'PACKAGE_DATADIR=\\"/usr/share/dnf\\"',
        'BUILDDIR=\\"dnf\\"',
        'SRCDIR=\\"dnf\\"',
    ],
    includes = ["."],
    linkopts = ["-rdynamic"],
    deps = [
        "@glib//:gio",
        "@glib//:glib",
        "@glib//:gobject",
        "@json-c//:json-c",
        "@libarchive//libarchive:archive",
        "@libdnf//:libdnf",
        "@libpeas//:libpeas",
        "@libsolv//:libsolv",
        "@rpm//:rpm",
        "@rpm//:rpmio",
        "@smartcols//:smartcols",
    ],
)

[
    platform_transition_binary(
        name = "microdnf_" + platform,
        binary = ":microdnf",
        target_platform = "//bazel:" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "microdnf_all",
    srcs = [
        ":microdnf_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
)

cc_binary(
    name = "rpm2archive",
    srcs = [
        "plugins/rpm2archive/rpm2archive.c",
        "plugins/rpm2archive/rpm2archive.h",
        "plugins/rpm2archive/rpm2archive-main.c",
    ],
    copts = COMMON_COPTS,
    includes = ["."],
    deps = [
        "@glib//:glib",
        "@libarchive//libarchive:archive",
        "@rpm//:rpm",
        "@rpm//:rpmio",
    ],
)

[
    platform_transition_binary(
        name = "rpm2archive_" + platform,
        binary = ":rpm2archive",
        target_platform = "//bazel:" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "rpm2archive_all",
    srcs = [
        ":rpm2archive_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
)

cc_binary(
    name = "lock",
    srcs = [
        "dnf-utils.c",
        "dnf-utils.h",
        "plugins/lock/lock.c",
        "plugins/lock/lock.h",
        "plugins/lock/lock-main.c",
    ],
    copts = COMMON_COPTS,
    defines = [
        'PACKAGE_LIBDIR=\\"/usr/lib64/dnf\\"',
        'PACKAGE_DATADIR=\\"/usr/share/dnf\\"',
        'BUILDDIR=\\"dnf\\"',
        'SRCDIR=\\"dnf\\"',
    ],
    includes = ["."],
    deps = [
        "@glib//:gio",
        "@glib//:glib",
        "@glib//:gobject",
        "@json-c//:json-c",
        "@libdnf//:libdnf",
        "@libsolv//:libsolv",
        "@rpm//:rpm",
        "@smartcols//:smartcols",
    ],
)

[
    platform_transition_binary(
        name = "lock_" + platform,
        binary = ":lock",
        target_platform = "//bazel:" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "lock_all",
    srcs = [
        ":lock_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
)

cc_binary(
    name = "mark",
    srcs = [
        "dnf-utils.c",
        "dnf-utils.h",
        "plugins/mark/mark.c",
        "plugins/mark/mark.h",
        "plugins/mark/mark-main.c",
    ],
    copts = COMMON_COPTS,
    defines = [
        'PACKAGE_LIBDIR=\\"/usr/lib64/dnf\\"',
        'PACKAGE_DATADIR=\\"/usr/share/dnf\\"',
        'BUILDDIR=\\"dnf\\"',
        'SRCDIR=\\"dnf\\"',
    ],
    includes = ["."],
    deps = [
        "@glib//:gio",
        "@glib//:glib",
        "@glib//:gobject",
        "@json-c//:json-c",
        "@libdnf//:libdnf",
        "@libsolv//:libsolv",
        "@rpm//:rpm",
        "@rpm//:rpmio",
        "@smartcols//:smartcols",
    ],
)

[
    platform_transition_binary(
        name = "mark_" + platform,
        binary = ":mark",
        target_platform = "//bazel:" + platform,
    )
    for platform in SUPPORTED_PLATFORMS
]

filegroup(
    name = "mark_all",
    srcs = [
        ":mark_" + platform
        for platform in SUPPORTED_PLATFORMS
    ],
)

alias(
    name = "rpmdb-mark",
    actual = ":mark",
)
