package(default_visibility = ["//visibility:public"])

exports_files([
    "MODULE.bazel",
    "defs.bzl",
    "extensions.bzl",
])

filegroup(
    name = "microdnf_module_files",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "defs.bzl",
        "extensions.bzl",
        "//rpm:all_files",
    ],
    visibility = ["//visibility:public"],
)

SUPPORTED_PLATFORMS = [
    "linux_amd64",
    "linux_arm64",
    "osx_amd64",
    "osx_arm64",
]

TARGETS = [
    "microdnf",
    "rpm2archive",
    "lock",
]

[
    alias(
        name = target,
        actual = "//dnf:" + target,
    )
    for target in TARGETS
]

[
    alias(
        name = "{}_{}".format(target, platform),
        actual = "//dnf:{}_{}".format(target, platform),
    )
    for target in TARGETS
    for platform in SUPPORTED_PLATFORMS
]

[
    alias(
        name = target + "_all",
        actual = "//dnf:" + target + "_all",
    )
    for target in TARGETS
]

genrule(
    name = "tools_archive",
    srcs = [
        "//:lock",
        "//:rpm2archive",
        "//:microdnf",
    ],
    outs = ["microdnf_tools.tar.gz"],
    cmd = """
        TMP=$$(mktemp -d)
        cp $(location //:lock) $$TMP/lock
        cp $(location //:rpm2archive) $$TMP/rpm2archive
        cp $(location //:microdnf) $$TMP/microdnf
        chmod 0755 $$TMP/lock $$TMP/rpm2archive $$TMP/microdnf
        tar -czf $@ -C $$TMP lock rpm2archive microdnf
        rm -rf $$TMP
    """,
)
