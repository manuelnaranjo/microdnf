load("@rules_bazel_integration_test//bazel_integration_test:defs.bzl", "bazel_integration_tests", "default_test_runner", "integration_test_utils")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rpm:defs.bzl", "rpm_archive", "rpm_extract", "rpm_lock", "rpm_mark", "rpm_package")

package(default_visibility = ["//visibility:public"])

# Step 1 test: Lockfile generation with RPM exclusion
rpm_lock(
    name = "test_generated_lock",
    arch = "x86_64,noarch",
    exclude = ["mystery-devel"],
    out = "test_generated_lock.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

# Step 3 test: Archive generation from RPM targets
rpm_archive(
    name = "tour_archive",
    compression = "gzip",
    rpms = ["@test_rpms//:tour"],
)

# Step 4 test: Extract files, dereference symlinks, mark executables
rpm_extract(
    name = "extracted_tour",
    archive = ":tour_archive",
    executables = [
        "usr/bin/away",
    ],
    files = [
        "etc/rollup",
        "usr/bin/away",
    ],
)

# Incremental lockfile tests
rpm_lock(
    name = "layer2_already_installed_lock",
    arch = "x86_64,noarch",
    lock_files = [":test_generated_lock.lock.json"],
    out = "layer2_already_installed.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

rpm_lock(
    name = "layer2_incremental_lock",
    arch = "x86_64,noarch",
    lock_files = [":test_generated_lock.lock.json"],
    out = "layer2_incremental.lock.json",
    packages = ["mystery-devel"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

rpm_lock(
    name = "layer2_both_lock",
    arch = "x86_64,noarch",
    lock_files = [":test_generated_lock.lock.json"],
    out = "layer2_both.lock.json",
    packages = [
        "mystery-devel",
        "tour",
    ],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

rpm_lock(
    name = "changed_integrity_lock",
    arch = "x86_64,noarch",
    lock_files = ["//e2e/testdata:changed_integrity.lock.json"],
    out = "changed_integrity.lock.json",
    packages = ["tour"],
    releasever = "9",
    repo_config = "//e2e/testdata:test.repo",
    repo_files = ["//e2e/testdata:test_repo_files"],
)

sh_test(
    name = "incremental_lock_test",
    srcs = ["test_incremental_lock.sh"],
    args = [
        "$(location :layer2_already_installed.lock.json)",
        "$(location :layer2_incremental.lock.json)",
        "$(location :layer2_both.lock.json)",
        "$(location :changed_integrity.lock.json)",
    ],
    data = [
        ":changed_integrity.lock.json",
        ":layer2_already_installed.lock.json",
        ":layer2_both.lock.json",
        ":layer2_incremental.lock.json",
    ],
)

# Verification test for Step 1, Step 3, Step 4
sh_test(
    name = "e2e_components_test",
    srcs = ["test_components.sh"],
    args = [
        "$(location :test_generated_lock.lock.json)",
        "$(location :tour_archive)",
        "$(location :extracted_tour_away)",
    ],
    data = [
        ":extracted_tour",
        ":extracted_tour_away",
        ":test_generated_lock.lock.json",
        ":tour_archive",
        "//e2e/testdata:test_repo_files",
    ],
)

# Oracle Linux 9 curl test: add curl binary from OL9 and mark it as installed into rpmdb
rpm_package(
    name = "ol9_curl_package",
    arch = "x86_64",
    package_name = "curl",
    rpm_file = "//e2e/testdata:ol9_repo/curl-7.76.1-40.el9_8.8.x86_64.rpm",
    version = "7.76.1-40.el9_8.8",
)

rpm_archive(
    name = "ol9_curl_archive",
    compression = "gzip",
    rpms = [":ol9_curl_package"],
)

rpm_extract(
    name = "extracted_ol9_curl",
    archive = ":ol9_curl_archive",
    executables = [
        "usr/bin/curl",
    ],
    files = [
        "usr/bin/curl",
    ],
)

rpm_mark(
    name = "ol9_marked_rpmdb",
    arch = "x86_64",
    packages = ["curl=7.76.1-40.el9_8.8"],
    releasever = "9",
    repo_config = "//e2e/testdata:ol9_repo/ol9.repo",
    repo_files = ["//e2e/testdata:ol9_repo_files"],
)

sh_test(
    name = "oracle_linux_curl_mark_test",
    srcs = ["test_ol9_curl_mark.sh"],
    args = [
        "$(location :extracted_ol9_curl_curl)",
        "$(location :ol9_marked_rpmdb)",
        "$(location //dnf:mark)",
        "$(location //e2e/testdata:ol9_repo/ol9.repo)",
        "e2e/testdata/ol9_repo",
    ],
    data = [
        ":extracted_ol9_curl",
        ":extracted_ol9_curl_curl",
        ":ol9_marked_rpmdb",
        "//dnf:mark",
        "//e2e/testdata:ol9_repo/ol9.repo",
        "//e2e/testdata:ol9_repo_files",
    ],
)

# Downstream integration test driven by rules_bazel_integration_test
default_test_runner(
    name = "default_test_runner",
    bazel_cmds = [
        "info",
        "build //...",
        "test //...",
    ],
)

bazel_integration_tests(
    name = "downstream_e2e_tests",
    bazel_versions = ["9.3.0"],
    exec_properties = {
        "dockerNetwork": "bridge",
        "network": "bridge",
    },
    tags = [
        "requires-network",
    ],
    test_runner = ":default_test_runner",
    workspace_files = [
        "//:microdnf_module_files",
    ] + glob(
        ["smoke_test/**"],
        exclude = ["smoke_test/bazel-*/**"],
    ),
    workspace_path = "e2e/smoke_test",
)
