module(
    name = "microdnf",
    version = "3.10.2",
)

# Core Bazel & platform dependencies from BCR (update to latest BCR versions on first run)
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "platforms_contrib", version = "0.0.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "bazel_lib", version = "3.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")

# Hermetic Python 3.14 via aspect_rules_py from BCR
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.6")

interpreters = use_extension("@aspect_rules_py//py:extensions.bzl", "python_interpreters")
interpreters.toolchain(python_version = "3.14")
use_repo(
    interpreters,
    "python_3_14_aarch64_apple_darwin",
    "python_3_14_aarch64_unknown_linux_gnu",
    "python_3_14_x86_64_apple_darwin",
    "python_3_14_x86_64_unknown_linux_gnu",
)

# Hermetic LLVM C/C++ toolchain from BCR
bazel_dep(name = "llvm", version = "0.6.1", dev_dependency = True)

# Remote Execution Platform setup from BCR
bazel_dep(name = "toolchains_buildbuddy", version = "0.0.4", dev_dependency = True)

buildbuddy = use_extension(
    "@toolchains_buildbuddy//:extensions.bzl",
    "buildbuddy",
    dev_dependency = True,
)
buildbuddy.platform(
    buildbuddy_container_image = "UBUNTU24_04_IMAGE",
)
use_repo(buildbuddy, "buildbuddy_toolchain")

register_execution_platforms(
    "//bazel:ubuntu24_04_amd64",
    "@buildbuddy_toolchain//:platform_linux_x86_64",
)

# BCR C/C++ leaf dependencies (latest versions in BCR)
bazel_dep(name = "pcre2", version = "10.44.bcr.2")
bazel_dep(name = "libffi", version = "3.4.7.bcr.2")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "xz", version = "5.4.5.bcr.8")
bazel_dep(name = "zstd", version = "1.5.7")
bazel_dep(name = "sqlite3", version = "3.49.1")
bazel_dep(name = "libyaml", version = "0.2.5")
bazel_dep(name = "libxml2", version = "2.15.3")
bazel_dep(name = "libexpat", version = "2.7.1.bcr.1")
bazel_dep(name = "openssl", version = "3.5.5.bcr.0")
bazel_dep(name = "curl", version = "8.12.0.bcr.1")

# Source-built C/C++ dependencies in bazel/3rdparty (<upstream_version>.bcr.<package-id>)
bazel_dep(name = "glib", version = "2.84.0.bcr.1")
bazel_dep(name = "gobject-introspection", version = "1.84.0.bcr.1")
bazel_dep(name = "libpeas", version = "1.36.0.bcr.1")
bazel_dep(name = "smartcols", version = "2.41.0.bcr.1")
bazel_dep(name = "json-c", version = "0.18.0.bcr.1")
bazel_dep(name = "libgpg-error", version = "1.51.0.bcr.1")
bazel_dep(name = "libassuan", version = "3.0.2.bcr.1")
bazel_dep(name = "gpgme", version = "1.24.2.bcr.1")
bazel_dep(name = "popt", version = "1.19.0.bcr.1")
bazel_dep(name = "file", version = "5.46.0.bcr.1")
bazel_dep(name = "rpm", version = "4.18.2.bcr.1")
bazel_dep(name = "libsolv", version = "0.7.32.bcr.1")
bazel_dep(name = "librepo", version = "1.19.0.bcr.1")
bazel_dep(name = "libmodulemd", version = "2.15.0.bcr.1")
bazel_dep(name = "libdnf", version = "0.74.0.bcr.1")
